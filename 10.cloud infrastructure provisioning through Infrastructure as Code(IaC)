4. Create Terraform Working Directory
Create Folder

Example:

terraform-aws
Open Terminal Inside Folder

Run:

cd terraform-aws
5. Create Terraform Configuration File

Create file:

main.tf
6. Add Terraform Code

Paste this code into main.tf

provider "aws" {
  region = "ap-south-1"
}

resource "aws_security_group" "web_sg" {
  name = "web-sg"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web_server" {
  ami           = "ami-0f58b397bc5c1f2e8"
  instance_type = "t2.micro"

  security_groups = [aws_security_group.web_sg.name]

  tags = {
    Name = "Terraform-EC2"
  }
}
7. Initialize Terraform

Run:

terraform init

Expected:

Terraform has been successfully initialized
8. Preview Infrastructure Changes

Run:

terraform plan

Terraform shows:

